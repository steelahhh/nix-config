{
  "agent": {
    "inline_assistant_model": {
      "provider": "ollama",
      "model": "deepseek-r1:latest"
    },
    "default_model": {
      "provider": "ollama",
      "model": "deepseek-r1:latest"
    }
  },
  "auto_update": false,
  "auto_install_extensions": {
    "ruby": true,
    "elixir": true,
    "nix": true,
    "toml": true,
    "catppuccin": true,
    "catppuccin-icons": true
  },
  "theme": "Catppuccin Macchiato",
  "icon_theme": "Catppuccin Macchiato",
  "buffer_font_size": 15,
  "vim_mode": true,
  "ui_font_family": "Monaspace Argon Var",
  "preferred_line_length": 100,
  "format_on_save": "off",
  "terminal": {
    "font_size": 14,
    "font_family": "MonaspiceKr Nerd Font Mono"
  },
  "languages": {
    "Elixir": {
      "enable_language_server": true,
      "language_servers": ["next-ls"]
    },
    "Go": {
      "enable_language_server": true,
      "tab_size": 2
    },
    "Rust": {
      "enable_language_server": true,
      "tab_size": 2
    },
    "Ruby": {
      "enable_language_server": true,
      "language_servers": ["solargraph", "rubocop", "!ruby-lsp"]
    },
    "Nix": {
      "enable_language_server": true,
      "language_servers": ["nixd"]
    }
  },
  "base_keymap": "JetBrains",
  "telemetry": {
    // Send debug info like crash reports.
    "diagnostics": false,
    // Send anonymized usage data like what languages you're using Zed with.
    "metrics": false
  },
  "lsp": {
    "next-ls": {
      "initialization_options": {
        "extensions": {
          // example configuring the extensions
          "credo": { "enable": false }
        },
        "experimental": {
          // example configuring the experimental options
          "completions": { "enable": true }
        }
      }
    },
    "solargraph": {
      "initialization_options": {
        "diagnostics": true,
        "formatting": true
      }
    }
  }
}
